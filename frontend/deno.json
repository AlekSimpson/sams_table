{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:typescript/tsc && deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview",
    "typecheck": "deno run -A npm:typescript/tsc --noEmit",
    // Unit/component tests (Vitest + React Testing Library). `test` runs once and exits;
    // `test:watch` re-runs on file changes during local development.
    "test": "deno run -A npm:vitest run",
    "test:watch": "deno run -A npm:vitest",
    // End-to-end tests (Playwright). Spins up the Vite dev server itself — no manual setup needed.
    "test:e2e": "deno run -A npm:playwright test"
  }
}
